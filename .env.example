# Offline extractive answers are the default. No credentials required.
LLM_PROVIDER=extractive
# Optional Groq; choose an available model in your account. No paid calls by default.
GROQ_API_KEY=
GROQ_MODEL=
EMBEDDING_BACKEND=semantic
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional immutable Hub commit for reproducible model loading.
EMBEDDING_REVISION=
MODEL_LOCAL_ONLY=true
CHUNK_SIZE=110
CHUNK_OVERLAP=20
TOP_K=3
SIMILARITY_THRESHOLD=0.28
MAX_TOOL_CALLS=4
